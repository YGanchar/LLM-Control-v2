# Копируйте этот файл в .env и заполните своими значениями.
# Реальные секреты (.env) в репозиторий не заливаются (.gitignore).

# --- Пути на клиентской машине ---
# Папка со моделями .gguf (сканируется сканером моделей)
LAST_SCAN_PATH='/path/to/your/models'
# Папка, куда сохраняются пресеты .mod
LAST_MODS_PATH='/home/USER/MODS/new'

# --- Параметры подключения к RTX-серверу ---
# Имя хоста из ~/.ssh/config или IP (должен резолвиться)
SSH_HOST="your-server-host"
# IP-адрес сервера для мониторинга и Wake-on-LAN
SERVER_HOST="192.168.1.100"
# Имя пользователя на сервере
SERVER_USER="your-username"
# MAC-адрес сетевого интерфейса сервера для Wake-on-LAN (Magic Packet)
SERVER_MAC="00:11:22:33:44:55"

# --- Пути к .conf-пресетам на сервере (NFS-монтирование) ---
DEFAULT_CONFIG_PATH="/path/on/server/llama-mode.conf"
# SECOND_CONFIG_PATH="/path/on/server/llama-mode-8081.conf"

# --- Опционально ---
# Ёмкость VRAM одной карты в ГБ (для автоматического подбора NGL/CTX)
GPU_RAM_GB="12"

# --- Примечание ---
# Аутентификация по SSH-ключам без пароля. Параметр SERVER_PASS больше не используется.
# Сгенерируйте ключ:  ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_llm -N ""
# Пришлите публичный ключ:  ssh-copy-id ~/.ssh/id_ed25519_llm.pub USER@SERVER
