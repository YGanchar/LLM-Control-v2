[Unit]
Description=Llama Server — Режим 1 (8080, GPU0+GPU1)
Documentation=file:///usr/local/bin/llmctl
After=network-online.target
Wants=network-online.target
# Модели лежат на NFS (/srv/models) — ждём их монтирования.
RequiresMountsFor=/srv/models

[Service]
Type=simple
# Работает от root: конфиги на NFS принадлежат yuri, бинарник в /usr/local/bin.
# root читает их без проблем; это упрощает запуск после перезагрузки.
ExecStart=/usr/local/bin/run-llama.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
